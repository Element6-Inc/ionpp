{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "testimonials": {
      "type": "object",
      "properties": {
        "sectionTitle": {
          "type": "string"
        },
        "maxChars": {
          "type": "number"
        },
        "maxCharsMobile": {
          "type": "number"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "content": {
                "type": "string"
              },
              "author": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "content",
              "author"
            ]
          }
        }
      },
      "required": [
        "sectionTitle",
        "maxChars",
        "items"
      ]
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "testimonials"
  ]
}