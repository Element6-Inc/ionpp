{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "site": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "description"
      ]
    },
    "hero": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "imageAlt": {
          "type": "string"
        },
        "bgColor": {
          "type": "string"
        },
        "image": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "ctaText": {
          "type": "string"
        },
        "ctaHref": {
          "type": "string"
        }
      },
      "required": [
        "title"
      ]
    },
    "centreText": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "icon": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "description"
      ]
    },
    "cardSlider": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "cards": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "icon": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "link": {
                "type": "string"
              }
            },
            "required": [
              "icon",
              "name",
              "description",
              "link"
            ]
          }
        }
      },
      "required": [
        "title",
        "cards"
      ]
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "imageAlt": {
            "type": "string"
          },
          "imagePosition": {
            "type": "string",
            "enum": [
              "left",
              "right"
            ]
          },
          "image": {
            "type": "string"
          },
          "buttonLink": {
            "type": "string"
          },
          "buttonText": {
            "type": "string"
          },
          "buttonTarget": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "description"
        ]
      }
    },
    "services": {
      "type": "object",
      "properties": {
        "checklist": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string"
              }
            },
            "required": [
              "text"
            ]
          }
        }
      },
      "required": [
        "checklist"
      ]
    },
    "contact": {
      "type": "object",
      "properties": {
        "header": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "phone": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "address": {
          "type": "string"
        }
      },
      "required": [
        "header",
        "description",
        "phone",
        "email",
        "address"
      ]
    },
    "footer": {
      "type": "object",
      "properties": {
        "socialLinks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "platform": {
                "type": "string"
              },
              "href": {
                "type": "string"
              }
            },
            "required": [
              "platform",
              "href"
            ]
          }
        }
      },
      "required": [
        "socialLinks"
      ]
    },
    "ctaKey": {
      "type": "string"
    },
    "cta": {
      "type": "object",
      "properties": {
        "heading": {
          "type": "string"
        },
        "button": {
          "type": "string"
        },
        "link": {
          "type": "string"
        },
        "imageAlt": {
          "type": "string"
        }
      },
      "required": [
        "heading",
        "button",
        "link"
      ]
    },
    "installMapCta": {
      "type": "object",
      "properties": {
        "eyebrow": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      },
      "required": [
        "eyebrow",
        "title",
        "description"
      ]
    },
    "installMap": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "subtitle": {
          "type": "string"
        },
        "office": {
          "type": "object",
          "properties": {
            "label": {
              "type": "string"
            },
            "address": {
              "type": "string"
            },
            "lat": {
              "type": "number"
            },
            "lng": {
              "type": "number"
            }
          },
          "required": [
            "label",
            "address",
            "lat",
            "lng"
          ]
        },
        "zoom": {
          "type": "number"
        },
        "installFee": {
          "type": "number"
        },
        "fuelSurcharge": {
          "type": "number"
        },
        "perKmRate": {
          "type": "number"
        },
        "flatRateTowns": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "match": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "fee": {
                "type": "number"
              }
            },
            "required": [
              "name",
              "match",
              "fee"
            ]
          }
        },
        "serviceArea": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "Polygon"
            },
            "coordinates": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    }
                  ]
                }
              }
            }
          },
          "required": [
            "type",
            "coordinates"
          ]
        },
        "messages": {
          "type": "object",
          "properties": {
            "loading": {
              "type": "string"
            },
            "outside": {
              "type": "string"
            },
            "notFound": {
              "type": "string"
            },
            "note": {
              "type": "string"
            }
          },
          "required": [
            "loading",
            "outside",
            "notFound",
            "note"
          ]
        }
      },
      "required": [
        "title",
        "subtitle",
        "office",
        "zoom",
        "installFee",
        "fuelSurcharge",
        "perKmRate",
        "flatRateTowns",
        "serviceArea",
        "messages"
      ]
    },
    "accordionHeading": {
      "type": "string"
    },
    "accordions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "content": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "content"
        ]
      }
    },
    "content": {
      "type": "object",
      "properties": {
        "eyebrow": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "primaryButton": {
          "type": "object",
          "properties": {
            "label": {
              "type": "string"
            },
            "href": {
              "type": "string"
            }
          },
          "required": [
            "label",
            "href"
          ]
        },
        "secondaryButton": {
          "type": "object",
          "properties": {
            "label": {
              "type": "string"
            },
            "href": {
              "type": "string"
            }
          },
          "required": [
            "label",
            "href"
          ]
        }
      },
      "required": [
        "eyebrow",
        "title",
        "description",
        "primaryButton",
        "secondaryButton"
      ]
    },
    "featureImage": {
      "type": "object",
      "properties": {
        "image": {
          "type": "string"
        },
        "imageAlt": {
          "type": "string"
        }
      },
      "required": [
        "image",
        "imageAlt"
      ]
    },
    "featureImages": {
      "maxItems": 4,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "image": {
            "type": "string"
          },
          "imageAlt": {
            "type": "string"
          }
        },
        "required": [
          "image",
          "imageAlt"
        ]
      }
    },
    "animatedIcon": {
      "type": "string"
    },
    "featureNav": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "icon": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "anchor": {
            "type": "string"
          }
        },
        "required": [
          "icon",
          "label",
          "anchor"
        ]
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "feature",
              "centre"
            ]
          },
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "imagePosition": {
            "type": "string",
            "enum": [
              "left",
              "right"
            ]
          },
          "image": {
            "type": "string"
          },
          "imageAlt": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "id",
          "title",
          "description"
        ]
      }
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "site",
    "hero"
  ]
}