{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "logoSlider": {
      "type": "object",
      "properties": {
        "animationDuration": {
          "type": "object",
          "properties": {
            "desktop": {
              "type": "string"
            },
            "mobile": {
              "type": "string"
            }
          },
          "required": [
            "desktop",
            "mobile"
          ]
        },
        "logos": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "file": {
                "type": "string"
              },
              "alt": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "file",
              "alt"
            ]
          }
        }
      },
      "required": [
        "animationDuration",
        "logos"
      ]
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "logoSlider"
  ]
}