{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "logo": {
      "type": "object",
      "properties": {
        "alt": {
          "type": "string"
        }
      },
      "required": [
        "alt"
      ]
    },
    "contact": {
      "type": "object",
      "properties": {
        "locations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "address": {
                "type": "string"
              },
              "phone": {
                "type": "object",
                "properties": {
                  "number": {
                    "type": "string"
                  },
                  "href": {
                    "type": "string"
                  }
                },
                "required": [
                  "number",
                  "href"
                ]
              },
              "email": {
                "type": "object",
                "properties": {
                  "address": {
                    "type": "string"
                  },
                  "href": {
                    "type": "string"
                  }
                },
                "required": [
                  "address",
                  "href"
                ]
              }
            },
            "required": [
              "name",
              "address",
              "phone"
            ]
          }
        }
      },
      "required": [
        "locations"
      ]
    },
    "hours": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "days": {
            "type": "string"
          },
          "time": {
            "type": "string"
          }
        },
        "required": [
          "days",
          "time"
        ]
      }
    },
    "copyright": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        }
      },
      "required": [
        "text"
      ]
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "logo",
    "contact",
    "hours",
    "copyright"
  ]
}