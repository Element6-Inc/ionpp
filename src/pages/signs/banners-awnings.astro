---
import InnerServicePage from "../../layouts/InnerServicePage.astro";
import { getEntry } from "astro:content";

const entry = await getEntry("pages", "signs/banners-awnings");
const content = entry!.data;

import hero          from "../../assets/heros/signs/banner.webp";
import feature1      from "../../assets/features/signs/banners-1.webp";
import feature2      from "../../assets/features/signs/banners-2.webp";
import animatedIcon  from "../../assets/icons/animated/banner.gif";
---

<InnerServicePage content={content} imageMap={{ hero, feature1, feature2 }} animatedIcon={animatedIcon} />
