---
/* =======================================================
 * CONTEST ENTRY FORM
 * Posts to a Google Apps Script web app (entryEndpoint in
 * src/data/contests.ts) that saves each entry to a Google
 * Sheet and rejects duplicate emails / phone numbers.
 * ======================================================= */
import Modal from "./Modal.astro";
import { entryEndpoint } from "../../data/contests";

interface Props {
  formName: string;
  contestSlug: string;
  organizationRequired?: boolean;
}

const { formName, contestSlug, organizationRequired = false } = Astro.props;
const formId = `${formName}-form`;
const modalId = `${formName}-modal`;
---

<form
  id={formId}
  name={formName}
  method="POST"
  class="form-group contest-form"
  data-modal={modalId}
  data-contest={contestSlug}
  data-endpoint={entryEndpoint}
>

  <p class="hidden">
    <label>Don't fill this out if you're human: <input name="bot-field" /></label>
  </p>

  <div>
    <label for={`${formName}-name`} class="form-label">
      Full name <span class="form-required">*</span>
    </label>
    <input type="text" id={`${formName}-name`} name="name" required autocomplete="name" class="form-input" />
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
    <div>
      <label for={`${formName}-email`} class="form-label">
        Email <span class="form-required">*</span>
      </label>
      <input type="email" id={`${formName}-email`} name="email" required autocomplete="email" class="form-input" />
    </div>
    <div>
      <label for={`${formName}-phone`} class="form-label">
        Phone <span class="form-required">*</span>
      </label>
      <input type="tel" id={`${formName}-phone`} name="phone" required autocomplete="tel" class="form-input" />
    </div>
  </div>

  <div>
    <label for={`${formName}-org`} class="form-label">
      Business / organization
      {organizationRequired && <span class="form-required">*</span>}
    </label>
    <input
      type="text"
      id={`${formName}-org`}
      name="organization"
      required={organizationRequired}
      autocomplete="organization"
      class="form-input"
    />
  </div>

  <label class="form-checkbox-label">
    <input type="checkbox" name="accepted-rules" value="yes" required class="form-checkbox" />
    <span>
      I am 18 or older, a resident of Ontario, and I agree to the
      <a href="/contest/rules" target="_blank" rel="noopener"> official contest rules</a>.
      <span class="form-required">*</span>
    </span>
  </label>


  <label class="form-checkbox-label">
    <input type="checkbox" name="marketing-consent" value="yes" class="form-checkbox" />
    <span>
      Optional: Yes, I would like to receive news and offers from ION Print &amp;
      Promo by email. I can unsubscribe at any time.
    </span>
  </label>

  <p class="form-error" data-duplicate-message>
    It looks like you've already entered this contest with that email or phone
    number. Only one entry per person counts.
  </p>

  <button type="submit" class="btn form-submit">Enter now</button>
</form>

<Modal id={modalId} title="You're entered!">
  <p class="text-slate-600 text-center">
    Thank you! Your entry has been received. Good luck in the draw on
    Monday, November 30.
  </p>
</Modal>

<script>
  // jane.doe+x@gmail.com and janedoe@gmail.com count as the same email
  function normaliseEmail(raw: string) {
    const email = raw.trim().toLowerCase();
    const [local = "", domain = ""] = email.split("@");
    let l = local.split("+")[0];
    if (domain === "gmail.com" || domain === "googlemail.com") l = l.replace(/\./g, "");
    return domain ? `${l}@${domain === "googlemail.com" ? "gmail.com" : domain}` : email;
  }

  function enteredEmails(key: string): string[] {
    try {
      return JSON.parse(localStorage.getItem(key) || "[]");
    } catch {
      return [];
    }
  }

  function initContestForms() {
    document.querySelectorAll<HTMLFormElement>("form.contest-form").forEach((form) => {
      if (form.dataset.bound) return;
      form.dataset.bound = "true";

      form.addEventListener("submit", async (e) => {
        e.preventDefault();

        // Soft duplicate check: same email already entered from this device
        const storageKey = `contest-entered:${form.dataset.contest}`;
        const emailValue = normaliseEmail(
          (form.elements.namedItem("email") as HTMLInputElement)?.value || ""
        );
        const dupMessage = form.querySelector<HTMLElement>("[data-duplicate-message]");
        if (emailValue && enteredEmails(storageKey).includes(emailValue)) {
          if (dupMessage) dupMessage.style.display = "block";
          return;
        }
        if (dupMessage) dupMessage.style.display = "none";

        const button = form.querySelector<HTMLButtonElement>("button[type=submit]");
        if (button) button.disabled = true;

        const endpoint = form.dataset.endpoint || "";
        if (!endpoint) {
          alert("Entries aren't open yet. Please try again soon.");
          if (button) button.disabled = false;
          return;
        }

        const field = (name: string) =>
          (form.elements.namedItem(name) as HTMLInputElement | null)?.value?.trim() || "";

        try {
          // text/plain keeps this a "simple" request (no CORS preflight),
          // which Google Apps Script web apps require.
          const response = await fetch(endpoint, {
            method: "POST",
            headers: { "Content-Type": "text/plain;charset=utf-8" },
            body: JSON.stringify({
              contest: form.dataset.contest,
              name: field("name"),
              email: field("email"),
              phone: field("phone"),
              organization: field("organization"),
              marketing: (form.elements.namedItem("marketing-consent") as HTMLInputElement | null)?.checked ? "Yes" : "No",
              website: field("bot-field"), // honeypot
            }),
          });
          const result = await response.json();

          if (result.ok) {
            try {
              const list = enteredEmails(storageKey);
              if (emailValue) list.push(emailValue);
              localStorage.setItem(storageKey, JSON.stringify(list));
            } catch {}
            (window as any).openModal(form.dataset.modal);
          } else if (result.error === "duplicate") {
            if (dupMessage) dupMessage.style.display = "block";
            if (button) button.disabled = false;
          } else {
            alert("There was an error submitting your entry. Please check your details and try again.");
            if (button) button.disabled = false;
          }
        } catch (error) {
          console.error("Contest entry error:", error);
          alert("There was an error submitting your entry. Please try again.");
          if (button) button.disabled = false;
        }
      });
    });
  }

  document.addEventListener("astro:page-load", initContestForms);
</script>
